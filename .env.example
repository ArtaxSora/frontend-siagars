# Salin ke .env.local lalu isi. Jangan commit nilai nyata (.env* di-ignore).

# --- Server-only (TIDAK masuk bundle browser) ---
# Pilih SATU backend untuk /api/v1 (bawaan bila kosong: production), lalu
# restart `npm run dev`. Halaman /status menampilkan backend yang dipakai.

# Production (publik, tanpa secret):
API_BASE_URL=https://siagars-backend.vercel.app
# Staging / Development (terkunci Vercel Authentication):
# API_BASE_URL=https://siagars-backend-git-develop-akmal-yonans-projects.vercel.app

# Hanya untuk staging: secret bypass dari tim backend. proxy.ts memasangnya
# sebagai header; diabaikan otomatis saat API_BASE_URL = production.
# JANGAN pernah memakai prefix NEXT_PUBLIC_ untuk nilai ini.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Publik (aman dilihat browser) ---
# Prefix path API; default same-origin /api/v1.
# NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Penyedia tile peta. Default memakai tile.openstreetmap.org hanya untuk
# pengembangan/demo ringan. Untuk produksi pilih penyedia yang kebijakan
# penggunaannya sesuai, lalu isi URL dan atribusinya.
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=© kontributor OpenStreetMap
