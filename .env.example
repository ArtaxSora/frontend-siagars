# Salin ke .env.local lalu sesuaikan. Jangan commit nilai nyata.

# --- Server-only (TIDAK masuk bundle browser) ---
# Backend online. Default: https://siagars-backend.vercel.app
# Backend menolak Origin selain PUBLIC_ORIGIN miliknya, jadi origin frontend
# yang Anda pakai (mis. http://localhost:3000) harus terdaftar di backend.
API_PROXY_TARGET=http://localhost:8080
API_PROXY_TARGET=https://siagars-backend.vercel.app

# --- Publik (aman dilihat browser) ---
# Prefix path API; default same-origin /api/v1.
# NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Penyedia tile peta. Default memakai tile.openstreetmap.org hanya untuk
# pengembangan/demo ringan. Untuk produksi pilih penyedia yang kebijakan
# penggunaannya sesuai, lalu isi URL dan atribusinya.
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=© kontributor OpenStreetMap
